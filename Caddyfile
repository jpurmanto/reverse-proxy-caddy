pacitankab.go.id {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	encode zstd gzip
	reverse_proxy pacitankab-web:3000
}

# Redirect www ke domain utama (hapus blok ini kalau tidak dipakai)
www.pacitankab.go.id {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	redir https://pacitankab.go.id{uri} permanent
}
